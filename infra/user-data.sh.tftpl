#!/bin/bash
set -euxo pipefail

dnf -y update
dnf -y install docker awscli-2 jq tar
systemctl enable --now docker

# --- TLS terminator -------------------------------------------------------
# Caddy obtains and renews a Let's Encrypt certificate on its own, so nothing
# here has an expiry date a human has to remember. Installed from the release
# tarball with its checksum verified, rather than from a third-party repository,
# so the whole supply chain for it is visible in this file.
CADDY_VERSION=2.11.4
cd /tmp
curl -fsSLO --retry 5 "https://github.com/caddyserver/caddy/releases/download/v$${CADDY_VERSION}/caddy_$${CADDY_VERSION}_linux_arm64.tar.gz"
curl -fsSLO --retry 5 "https://github.com/caddyserver/caddy/releases/download/v$${CADDY_VERSION}/caddy_$${CADDY_VERSION}_checksums.txt"
# sha512sum, not sha256sum: Caddy publishes 128-hex-character SHA-512 digests,
# and sha256sum rejects them outright with "no properly formatted SHA256
# checksum lines found" — which aborts this script and, because user-data runs
# exactly once, leaves an instance that never installs anything.
grep " caddy_$${CADDY_VERSION}_linux_arm64.tar.gz$" "caddy_$${CADDY_VERSION}_checksums.txt" | sha512sum -c -
tar -xzf "caddy_$${CADDY_VERSION}_linux_arm64.tar.gz" caddy
install -m 0755 caddy /usr/local/bin/caddy
rm -f caddy caddy_$${CADDY_VERSION}_*

id caddy >/dev/null 2>&1 || useradd --system --home /var/lib/caddy --shell /usr/sbin/nologin caddy
mkdir -p /etc/caddy /var/lib/caddy
chown -R caddy:caddy /var/lib/caddy

# The global block is emitted only when there is an address to put in it: a
# bare `email` directive with no argument is a Caddyfile parse error, so an
# unset acme_email would stop Caddy starting at all.
ACME_EMAIL="${acme_email}"
{
  if [ -n "$ACME_EMAIL" ]; then
    printf '{\n  email %s\n}\n\n' "$ACME_EMAIL"
  fi
  # /readyz checks the database and is exempt from rate limiting, so from the
  # internet it is a cheap way to tie up the connection pool. Nothing outside
  # needs it; Docker's health check calls /healthz on the loopback.
  printf '%s {\n  respond /readyz 404\n  reverse_proxy 127.0.0.1:3001\n}\n' "${api_domain}"
} >/etc/caddy/Caddyfile

# Fail here, loudly and early, rather than leaving a service that will not start.
/usr/local/bin/caddy validate --config /etc/caddy/Caddyfile

cat >/etc/systemd/system/caddy.service <<'CADDYUNIT'
[Unit]
Description=Caddy
After=network.target

[Service]
User=caddy
Group=caddy
ExecStart=/usr/local/bin/caddy run --environ --config /etc/caddy/Caddyfile
ExecReload=/usr/local/bin/caddy reload --config /etc/caddy/Caddyfile --force
Restart=on-failure
# Binding 80 and 443 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=full
Environment=XDG_DATA_HOME=/var/lib/caddy
Environment=XDG_CONFIG_HOME=/var/lib/caddy

[Install]
WantedBy=multi-user.target
CADDYUNIT

systemctl daemon-reload
systemctl enable --now caddy.service

# --- API ------------------------------------------------------------------
# Credentials are read at start time from Secrets Manager, never baked into the
# image or written to disk in plaintext. The unit re-reads them on every restart,
# so rotating the password is a restart rather than a redeploy.
cat >/usr/local/bin/api-start <<'RUNNER'
#!/bin/bash
set -euo pipefail

REGION="${region}"
SECRET_ARN="${secret_arn}"
IMAGE="${image}"
LOG_GROUP="${log_group}"
CA_PATH="${region_ca}"

# Amazon's roots are not in any public trust store, so the driver cannot verify
# an RDS certificate without them. Fetched on every start rather than only at
# first boot: a transient failure then heals on the next restart instead of
# leaving an instance that can never connect.
mkdir -p "$(dirname "$CA_PATH")"
curl -fsS --retry 5 --retry-delay 2 -o "$CA_PATH" \
  "https://truststore.pki.rds.amazonaws.com/$REGION/$REGION-bundle.pem"

aws ecr get-login-password --region "$REGION" \
  | docker login --username AWS --password-stdin "$${IMAGE%%/*}"

docker pull "$IMAGE"

SECRET=$(aws secretsmanager get-secret-value --region "$REGION" \
  --secret-id "$SECRET_ARN" --query SecretString --output text)
# Exported and passed to docker by name below (-e NAME), so the values never
# appear on a command line: docker run stays in the foreground for the life of
# the container, and its arguments are readable by anyone who can run ps.
export DATABASE_URL FRONTEND_SECRET
DATABASE_URL=$(printf '%s' "$SECRET" | jq -r .database_url)
FRONTEND_SECRET=$(printf '%s' "$SECRET" | jq -r .frontend_secret)

docker rm -f api >/dev/null 2>&1 || true

# Bound to the loopback interface, not 0.0.0.0: the only way in is through
# Caddy, so there is no plaintext port reachable from the internet even though
# the security group would allow one.
exec docker run --rm --name api \
  -p 127.0.0.1:3001:3001 \
  -e NODE_ENV=production \
  -e PORT=3001 \
  -e DATABASE_URL \
  -e FRONTEND_SECRET \
  -e SUPABASE_URL="${supabase_url}" \
  -e LOG_LEVEL=info \
  -e TRUST_PROXY_HOPS=1 \
  -v "$(dirname "$CA_PATH")":"$(dirname "$CA_PATH")":ro \
  --log-driver=awslogs \
  --log-opt awslogs-region="$REGION" \
  --log-opt awslogs-group="$LOG_GROUP" \
  --log-opt awslogs-stream=api \
  "$IMAGE"
RUNNER
chmod +x /usr/local/bin/api-start

cat >/etc/systemd/system/api.service <<'UNIT'
[Unit]
Description=UIUC Housing Review API
After=docker.service
Requires=docker.service

[Service]
ExecStart=/usr/local/bin/api-start
ExecStop=/usr/bin/docker stop api
Restart=always
# On a fresh stack no image has been pushed yet, so this fails until the first
# deploy. Backing off keeps it retrying without filling the log with attempts.
RestartSec=30

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now api.service
