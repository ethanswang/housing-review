# Supabase → Project Settings → API
# The anon key is public by design; Row Level Security (supabase/schema.sql) is
# what controls access. Never put the service_role key in this file.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The API the pages read from (server/, `npm run dev` there). Defaults to
# http://localhost:3001. Production also sets FRONTEND_SECRET, matching the
# API's; see docs/API.md.
API_URL=http://localhost:3001
