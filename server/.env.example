# The variables for running the API from source. Nothing reads this file:
# export them in your shell (npm run dev already defaults DATABASE_URL and
# SUPABASE_URL). docs/API.md documents every variable.

# The compose database. npm run dev defaults to this already.
DATABASE_URL=postgres://housing:housing_dev@localhost:5433/housing

# Your Supabase project. Only its public keys are fetched; a placeholder works
# until you sign in against a real project.
SUPABASE_URL=https://your-project-ref.supabase.co

# Optional. Shared with the website once it calls the API; at least 32
# characters. Leave unset locally unless you are testing the frontend's
# forwarded-address rate limiting.
# FRONTEND_SECRET=

# Optional.
# LOG_LEVEL=info
